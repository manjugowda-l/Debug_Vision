{
  "name": "debugvision-extension",
  "displayName": "DebugVision",
  "description": "AI-powered intelligent debugging for VS Code",
  "version": "0.1.0",
  "publisher": "debugvision",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "categories": [
    "Debuggers",
    "Machine Learning"
  ],
  "keywords": [
    "debug",
    "debugging",
    "ai",
    "intelligent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/debugvision.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:debugvision.helloWorld"
  ],
  "contributes": {
    "commands": [
  {
    "command": "debugvision.helloWorld",
    "title": "DebugVision: Hello World"
  },
  {
    "command": "debugvision.startDebugSession",
    "title": "🐞 DebugVision: Start AI Debug Session"
  }
]
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsc --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "debugvision-shared": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "typescript": "^5.3.3"
  }
}
